{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/crates/verona-rt-sys/verona-rt/src/rt",
                "${workspaceFolder}/crates/verona-rt-sys/snmalloc/src/"
            ],
            "defines": [
                "MALLOC_USABLE_SIZE_QUALIFIER=const",
                "SNMALLOC_CHEAP_CHECKS",
                "SNMALLOC_HAS_LINUX_RANDOM_H",
                "SNMALLOC_NO_REALLOCARR",
                "SNMALLOC_NO_REALLOCARRAY",
                "SNMALLOC_PLATFORM_HAS_GETENTROPY",
                "SNMALLOC_USE_CXX17"
            ],
            /*
            In clang-18, they changed they way that stddef is implemented to rely on 
            a preprocessor intrinsic to access the module system. As vscode's c++
            frontend doesn't know about this, it manages to parse stddef.h without
            finding the definition of size_t. This leads to all sorts of horrific
            parsing errors, which then cascade into horrific name-resolution errors.

            To work around, use clang-17's headers for vscode autocomplete.
            */
            "compilerPath": "/usr/bin/clang-17",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-clang-x64"
        }
    ],
    "version": 4
}